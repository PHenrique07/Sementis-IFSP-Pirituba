# Arquivo de configuração de ambiente do Sementis
# Copie este arquivo para .env e insira suas chaves:

# Chave da OpenRouter para a SemeIA
OPENROUTER_API_KEY=sua_chave_openrouter_aqui

# Adaptador ativo da SemeIA (opcional - padrao: openrouter)
# Opcoes: openrouter | openai | gemini | mock
SEMEIA_ADAPTADOR=openrouter
